# Docker is available on the development machine. This uses the official image.
GITHUB_MCP_COMMAND=docker
GITHUB_MCP_ARGS=run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server stdio
# The official server reads this token from its environment.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional external Gmail MCP server. Leave unset to use the local mock.
GMAIL_MCP_COMMAND=
GMAIL_MCP_ARGS=stdio

# Optional external Google Drive MCP server. Leave unset to use the local mock.
GOOGLE_DRIVE_MCP_COMMAND=
GOOGLE_DRIVE_MCP_ARGS=stdio

# For real Google Workspace connections, point this at the downloaded JSON.
GOOGLE_OAUTH_CLIENT_JSON=C:\Users\User\Downloads\client_secret_<client-id>.json

# Optional fourth MCP server using Streamable HTTP.
# MCP_HTTP_SERVER_NAME=remote
# MCP_HTTP_SERVER_URL=https://example.com/mcp
